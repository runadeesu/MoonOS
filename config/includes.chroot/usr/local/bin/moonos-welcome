#!/usr/bin/python3
import os
import subprocess
import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, Gdk

CSS = b"""
window { background-color: rgba(5, 11, 20, 0.96); color: #f5f7fb; }
.shell { background-color: rgba(7, 15, 27, 0.95); border: 1px solid rgba(190, 218, 255, 0.24); border-radius: 22px; }
.sidebar { background-color: rgba(12, 23, 38, 0.86); border-right: 1px solid rgba(190, 218, 255, 0.15); border-radius: 18px; padding: 16px; }
.control { background-color: rgba(15, 27, 44, 0.92); border: 1px solid rgba(190, 218, 255, 0.18); border-radius: 18px; padding: 18px; }
.toolbar { background-color: rgba(14, 25, 41, 0.82); border-bottom: 1px solid rgba(190, 218, 255, 0.14); padding: 12px 18px; }
.moon-title { color: #ffffff; font-size: 18px; font-weight: 700; }
.section { color: #dce8f7; font-size: 12px; font-weight: 700; }
.muted { color: #8294aa; font-size: 11px; }
.side-button { background: transparent; color: #c8d5e5; border: 0; border-radius: 10px; padding: 8px 10px; }
.side-button:hover { background-color: rgba(85, 149, 220, 0.20); color: #ffffff; }
.folder { background-color: rgba(18, 34, 55, 0.72); border: 1px solid rgba(140, 187, 236, 0.16); border-radius: 15px; padding: 15px; color: #eaf4ff; }
.folder:hover { background-color: rgba(33, 63, 96, 0.86); border-color: rgba(102, 178, 255, 0.62); }
.quick { background-color: rgba(35, 53, 74, 0.85); border: 1px solid rgba(210, 230, 255, 0.12); border-radius: 12px; padding: 10px; color: #edf6ff; }
.quick:hover { background-color: rgba(47, 100, 164, 0.92); }
.quick-on { background-color: #2379e9; border: 1px solid #65a8ff; border-radius: 12px; padding: 10px; color: #ffffff; }
.media { background-color: rgba(6, 14, 27, 0.72); border: 1px solid rgba(190, 218, 255, 0.14); border-radius: 14px; padding: 13px; }
.feature { background-color: rgba(20, 36, 58, 0.78); border: 1px solid rgba(150, 194, 240, 0.16); border-radius: 13px; padding: 12px; color: #f1f7ff; }
.online { color: #78e9bd; font-size: 11px; font-weight: 700; }
scale trough { background-color: #26384c; border-radius: 8px; min-height: 6px; }
scale highlight { background-color: #5ba8ff; border-radius: 8px; }
scale slider { background-color: #f7fbff; border: 0; min-width: 15px; min-height: 15px; border-radius: 9px; }
"""

FOLDERS = [
    ("user-desktop", "デスクトップ", "Desktop"),
    ("folder-documents", "ドキュメント", "Documents"),
    ("folder-download", "ダウンロード", "Downloads"),
    ("folder-pictures", "ピクチャ", "Pictures"),
    ("folder-music", "ミュージック", "Music"),
    ("folder-videos", "ビデオ", "Videos"),
]


class MoonDesktop(Gtk.Window):
    def __init__(self):
        super().__init__(title="MoonOS // Moon Explorer")
        self.set_default_size(1080, 570)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(12)
        self.connect("destroy", Gtk.main_quit)
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        shell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        shell.get_style_context().add_class("shell")
        self.add(shell)
        shell.pack_start(self.toolbar(), False, False, 0)
        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        body.set_border_width(12)
        shell.pack_start(body, True, True, 0)
        body.pack_start(self.sidebar(), False, False, 0)
        body.pack_start(self.explorer(), True, True, 0)
        body.pack_end(self.control_center(), False, False, 0)

    def toolbar(self):
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        bar.get_style_context().add_class("toolbar")
        moon = Gtk.Label(label="☾  Moon Explorer")
        moon.get_style_context().add_class("moon-title")
        bar.pack_start(moon, False, False, 0)
        path = Gtk.Label(label="⌂  /home/moon", xalign=0)
        path.get_style_context().add_class("muted")
        bar.pack_start(path, True, True, 10)
        status = Gtk.Label(label="●  MOON CORE ONLINE")
        status.get_style_context().add_class("online")
        bar.pack_end(status, False, False, 0)
        return bar

    def sidebar(self):
        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        side.set_size_request(170, -1)
        side.get_style_context().add_class("sidebar")
        recent = Gtk.Label(label="お気に入り", xalign=0)
        recent.get_style_context().add_class("section")
        side.pack_start(recent, False, False, 6)
        for icon, label, command in [
            ("document-open-recent", "最近使用した項目", "thunar"),
            ("user-home", "ホーム", "thunar"),
            ("user-desktop", "デスクトップ", "thunar"),
            ("folder-documents", "ドキュメント", "thunar"),
            ("folder-download", "ダウンロード", "thunar"),
            ("folder-pictures", "ピクチャ", "thunar"),
            ("folder-music", "ミュージック", "thunar"),
            ("folder-videos", "ビデオ", "thunar"),
        ]:
            button = self.icon_button(icon, label, "side-button")
            button.connect("clicked", self.launch, command)
            side.pack_start(button, False, False, 0)
        spacer = Gtk.Box()
        side.pack_start(spacer, True, True, 0)
        version = Gtk.Label(label="MoonOS 0.1  •  Luna Core", xalign=0)
        version.get_style_context().add_class("muted")
        side.pack_end(version, False, False, 4)
        return side

    def explorer(self):
        center = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        heading = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        title = Gtk.Label(label="ホーム", xalign=0)
        title.get_style_context().add_class("moon-title")
        count = Gtk.Label(label="6個のフォルダー", xalign=1)
        count.get_style_context().add_class("muted")
        heading.pack_start(title, True, True, 0)
        heading.pack_end(count, False, False, 0)
        center.pack_start(heading, False, False, 2)
        grid = Gtk.Grid(column_spacing=10, row_spacing=10, column_homogeneous=True, row_homogeneous=True)
        for index, (icon, label, folder) in enumerate(FOLDERS):
            button = Gtk.Button()
            button.set_relief(Gtk.ReliefStyle.NONE)
            button.get_style_context().add_class("folder")
            content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
            content.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG), False, False, 0)
            name = Gtk.Label(label=label)
            name.get_style_context().add_class("section")
            content.pack_start(name, False, False, 0)
            button.add(content)
            button.connect("clicked", self.open_folder, folder)
            grid.attach(button, index % 3, index // 3, 1, 1)
        center.pack_start(grid, True, True, 0)
        features = Gtk.Grid(column_spacing=10, row_spacing=10, column_homogeneous=True)
        for col, (icon, title, copy, command) in enumerate([
            ("moonos-gamevault", "GAME MODE", "最高のパフォーマンス", "moonos-install-steam"),
            ("moonos-performance", "高速起動", "最速5秒以内を目標", "moonos-performance"),
            ("moonos-settings", "SYSTEM", "安全性と更新を管理", "xfce4-settings-manager"),
        ]):
            card = self.feature_card(icon, title, copy)
            card.connect("clicked", self.launch, command)
            features.attach(card, col, 0, 1, 1)
        center.pack_end(features, False, False, 0)
        return center

    def control_center(self):
        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=11)
        panel.set_size_request(285, -1)
        panel.get_style_context().add_class("control")
        title = Gtk.Label(label="コントロールセンター", xalign=0)
        title.get_style_context().add_class("moon-title")
        panel.pack_start(title, False, False, 0)
        quick = Gtk.Grid(column_spacing=8, row_spacing=8, column_homogeneous=True)
        items = [
            ("network-wireless", "Wi-Fi\nMoon_5G", "nm-connection-editor", "quick-on"),
            ("bluetooth-active", "Bluetooth\n設定", "xfce4-settings-manager", "quick"),
            ("audio-volume-high", "サウンド\nオン", "pavucontrol", "quick-on"),
            ("video-display", "画面設定", "xfce4-display-settings", "quick"),
        ]
        for index, (icon, label, command, style) in enumerate(items):
            button = self.icon_button(icon, label, style)
            button.connect("clicked", self.launch, command)
            quick.attach(button, index % 2, index // 2, 1, 1)
        panel.pack_start(quick, False, False, 0)
        panel.pack_start(self.slider_row("明るさ", "display-brightness", 72, None), False, False, 0)
        panel.pack_start(self.slider_row("音量", "audio-volume-high", 58, self.set_volume), False, False, 0)
        media = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        media.get_style_context().add_class("media")
        now = Gtk.Label(label="♪  Dream in the Moonlight", xalign=0)
        now.get_style_context().add_class("section")
        artist = Gtk.Label(label="MoonOS Soundscape", xalign=0)
        artist.get_style_context().add_class("muted")
        controls = Gtk.Label(label="◀      ▶      ▶|", xalign=0.5)
        media.pack_start(now, False, False, 0)
        media.pack_start(artist, False, False, 0)
        media.pack_start(controls, False, False, 4)
        panel.pack_start(media, False, False, 0)
        focus = Gtk.Grid(column_spacing=8, column_homogeneous=True)
        for col, (icon, label) in enumerate([("weather-clear-night", "ダークモード"), ("preferences-system", "集中モード")]):
            button = self.icon_button(icon, label, "quick")
            button.connect("clicked", self.launch, "xfce4-settings-manager")
            focus.attach(button, col, 0, 1, 1)
        panel.pack_end(focus, False, False, 0)
        return panel

    @staticmethod
    def icon_button(icon, label, style):
        button = Gtk.Button()
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.get_style_context().add_class(style)
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        box.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.BUTTON), False, False, 0)
        box.pack_start(Gtk.Label(label=label, xalign=0), True, True, 0)
        button.add(box)
        return button

    @staticmethod
    def feature_card(icon, title, copy):
        button = Gtk.Button()
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.get_style_context().add_class("feature")
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        box.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.DIALOG), False, False, 0)
        labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        first = Gtk.Label(label=title, xalign=0)
        first.get_style_context().add_class("section")
        second = Gtk.Label(label=copy, xalign=0)
        second.get_style_context().add_class("muted")
        labels.pack_start(first, False, False, 0)
        labels.pack_start(second, False, False, 0)
        box.pack_start(labels, True, True, 0)
        button.add(box)
        return button

    @staticmethod
    def slider_row(_label, icon, value, callback):
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        box.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.BUTTON), False, False, 0)
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        scale.set_draw_value(False)
        scale.set_value(value)
        if callback:
            scale.connect("value-changed", callback)
        box.pack_start(scale, True, True, 0)
        return box

    @staticmethod
    def launch(_widget, command):
        try:
            subprocess.Popen([command])
        except OSError:
            pass

    @staticmethod
    def open_folder(_widget, folder):
        path = os.path.join(os.path.expanduser("~"), folder)
        subprocess.Popen(["thunar", path if os.path.isdir(path) else os.path.expanduser("~")])

    @staticmethod
    def set_volume(scale):
        value = int(scale.get_value())
        subprocess.run(["pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{value}%"], check=False)


MoonDesktop().show_all()
Gtk.main()
